{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.eol": "\n",
  "files.encoding": "utf8",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  "[javascript][typescript][javascriptreact][typescriptreact][json][jsonc][html][css][scss][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "prettier.requireConfig": true,

  // Tailwind v4: тема (токены дизайна) задана в этом файле, по нему работают подсказки классов.
  "tailwindCSS.experimental.configFile": "apps/web/src/index.css"
}
