# Скопировать в .env (он не попадает в репозиторий) и при необходимости поменять.
# 127.0.0.1, а не localhost: на Windows localhost сначала идёт в IPv6 и может не подключиться.
DATABASE_URL=postgres://sport:sport@127.0.0.1:5432/sport
PORT=3000
SESSION_TTL_DAYS=7
# true на деплое: сид при старте наполняет базу, только если версия демо-данных в коде новее.
SEED_ON_START=false
